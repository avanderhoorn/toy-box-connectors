{
  "include": ["**/*.ts"],
  "exclude": ["spikes"],
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "lib": ["ESNext"],
    "types": ["bun-types"],

    /* Bundler mode */
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "noEmit": true,

    /* Linting */
    "skipLibCheck": true,
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedSideEffectImports": true,

    // The Slack feature is `slackapi` so its alias can't shadow the Slack SDKs' `@slack/*` scope.
    "paths": {
      "@/*": ["./src/*"],
      "@activity/*": ["./src/features/activity/*"],
      "@bridge/*": ["./src/features/bridge/*"],
      "@commands/*": ["./src/features/commands/*"],
      "@files/*": ["./src/features/files/*"],
      "@links/*": ["./src/features/links/*"],
      "@outbox/*": ["./src/features/outbox/*"],
      "@requests/*": ["./src/features/requests/*"],
      "@slackapi/*": ["./src/features/slackapi/*"],
      "@toybox/*": ["./src/features/toybox/*"],
      "@wakes/*": ["./src/features/wakes/*"]
    }
  }
}
