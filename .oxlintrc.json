{
  "plugins": ["typescript", "import"],
  "ignorePatterns": ["spikes/**"],
  "categories": {
    "correctness": "error"
  },
  "overrides": [
    {
      "files": ["**/*.test.ts"],
      "rules": {
        "typescript/await-thenable": "off",
        "typescript/no-floating-promises": [
          "warn",
          {
            "allowForKnownSafeCalls": [
              {
                "from": "package",
                "name": "module",
                "package": "bun-types"
              }
            ]
          }
        ]
      }
    }
  ],
  "options": {
    // Type errors come from `bun check`, which the check script runs after linting.
    "typeAware": true
  }
}
