{
  "plugins": ["typescript", "import"],
  "ignorePatterns": ["spikes/**"],
  "categories": {
    "correctness": "error"
  },
  "overrides": [
    {
      // Bun colors what `console.error` writes to a terminal red, so the bridge says what it's
      // doing through `log` in src/shared/log.ts.
      "files": ["src/**/*.ts", "cli/**/*.ts"],
      "rules": {
        "no-console": ["error", { "allow": ["log"] }]
      }
    },
    {
      "files": ["**/*.test.ts"],
      "rules": {
        "typescript/await-thenable": "off",
        "typescript/no-floating-promises": [
          "warn",
          {
            "allowForKnownSafeCalls": [
              {
                "from": "package",
                "name": "module",
                "package": "bun-types"
              }
            ]
          }
        ]
      }
    }
  ],
  "options": {
    // Type errors come from `bun check`, which the check script runs after linting.
    "typeAware": true
  }
}
